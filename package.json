{
    "name": "@pairsystems/n8n-nodes-goodmem",
    "version": "2.0.0",
    "description": "n8n community node for the GoodMem semantic memory API: store, search and manage memories",
    "license": "MIT",
    "homepage": "https://github.com/PAIR-Systems-Inc/n8n-nodes-goodmem#readme",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Zaid Abdulrehman",
        "email": "zaid.abdulrehman@pairsys.ai"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/PAIR-Systems-Inc/n8n-nodes-goodmem.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease",
        "test": "npm run build && node --test \"test/**/*.test.js\""
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/GoodmemApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Goodmem/Goodmem.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "^0.46.3",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
